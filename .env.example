# Optional: enables Phantom Portal/social providers in addition to the extension.
# Leave unset to run extension-only without a Portal appId.
VITE_PHANTOM_APP_ID=

# Optional: must be allowlisted in Phantom Portal when VITE_PHANTOM_APP_ID is set.
# Defaults at runtime to `${window.location.origin}/auth/phantom/callback`.
VITE_PHANTOM_REDIRECT_URL=

# Optional: enables Convex-backed WorkOS AuthKit sign-in and users table sync.
# VITE_CONVEX_URL is generated by `npx convex dev`.
VITE_CONVEX_URL=
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
